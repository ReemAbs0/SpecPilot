# SpecPilot frontend environment variables.
# Copy this file to `.env` and adjust as needed. `.env` is git-ignored.

# Base URL of the backend API.
# - Local dev: leave empty so API calls stay relative (`/api/...`) and the Vite dev server
#   proxies them to the backend (see vite.config.ts). (The proxy target is set in vite.config.)
# - Production (Vercel): set this to the deployed backend URL so the frontend calls it directly
#   cross-origin, e.g. https://specpilot-backend.onrender.com
VITE_API_BASE_URL=

# --- Firebase Web SDK (feature/firebase-auth) ---
# Used for authentication only (the frontend never talks to Firestore directly). These values
# come from your Firebase project's Web App config and are public by design for a web client.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=your-firebase-web-app-id
