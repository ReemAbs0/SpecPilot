rules_version = '2';

// SpecPilot Firestore Security Rules (feature/firebase-auth).
//
// All persistence flows through the Express backend, which uses the Firebase Admin SDK.
// The Admin SDK runs with service-account privileges and BYPASSES these rules entirely, so
// the backend can still read and write user specifications. Direct client access (e.g. the
// Firebase Web SDK from the browser) is denied across the board — the sole authorization
// boundary for clients is the backend's ID-token verification middleware.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
