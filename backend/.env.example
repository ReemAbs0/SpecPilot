# SpecPilot backend environment variables.
# Copy this file to `.env` and fill in real values. `.env` is git-ignored and MUST NOT be
# committed (secrets stay out of source per the project constitution).

# --- Fetch.ai hosted inference endpoint (research.md #1) ---
# API key for the Fetch.ai / ASI:One hosted inference endpoint.
FETCH_AI_API_KEY=your-key-here
# Base URL of the hosted inference endpoint the agent stages call.
FETCH_AI_ENDPOINT_URL=https://api.asi1.ai/v1
# Model name to request from the hosted endpoint (optional; defaults to "asi1-mini").
FETCH_AI_MODEL=asi1-mini

# --- Server ---
# Port the Express server listens on. Locally defaults to 4000. On Render this is injected
# automatically — do not set it there.
PORT=4000

# --- CORS (deployment) ---
# Comma-separated list of allowed frontend origins for cross-origin requests (production, where
# the frontend and backend are on different domains). Leave empty locally (all origins allowed).
# In production set it to the deployed frontend URL, e.g. https://your-app.vercel.app
CORS_ORIGIN=

# --- Generation behavior ---
# Maximum time (ms) a generation may run before it is treated as a failure (FR-011a; 90s).
GENERATION_TIMEOUT_MS=90000
# Minimum accepted idea-description length in characters (FR-005; research.md #4).
IDEA_MIN_LENGTH=20
# Maximum accepted idea-description length in characters (FR-006; research.md #4).
IDEA_MAX_LENGTH=2000

# --- Firebase Admin (feature/firebase-auth) ---
# Used only for account persistence (verifying user ID tokens + writing saved specifications
# to Firestore with the Admin SDK). The generation flow above does NOT require any of these.
#
# Your Firebase project id (from the Firebase console). Optional if it is present in the
# service account credential, but setting it explicitly is recommended.
FIREBASE_PROJECT_ID=your-firebase-project-id
# Provide the service account ONE of two ways (inline wins if both are set):
#   1. Path to the downloaded service-account JSON file (recommended for local dev).
#      This file is a secret — keep it out of git (see .gitignore).
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
#   2. The service-account JSON inlined as a single-line string (handy for hosted deploys
#      that inject secrets as env vars). Leave empty to use the path above.
FIREBASE_SERVICE_ACCOUNT=
